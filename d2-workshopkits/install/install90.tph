//
//paladin

//Confessor (d2wk5)
ACTION_IF (RESOURCE_CONTAINS ~kit.ids~ ~D2CONFESSOR~) BEGIN
  OUTER_SPRINT kitid ~d2wk5~
  OUTER_SPRINT kitname ~CONFESSOR~
  INCLUDE ~%install%/variables2.tph~
  INCLUDE ~%install%/%kitname%var.tph~
  INCLUDE ~%install%/nopaladinheal.tph~
  OUTER_SPRINT confessor  ~%kitid%~
END

//Temple Knight (d2wk6)
ACTION_IF (RESOURCE_CONTAINS ~kit.ids~ ~D2TEMPLEKNIGHT~) BEGIN
  OUTER_SPRINT kitid ~d2wk6~
  OUTER_SPRINT kitname ~TEMPLEKNIGHT~
  INCLUDE ~%install%/variables2.tph~
  OUTER_SPRINT templeknight  ~%kitid%~

  // bolt of glory
  COPY_EXISTING ~%s2%.SPL~ ~override~
    LPF olvynspells_exmetalv END
    LPF olvynspells_mesafesp INT_VAR match_opcode=177 END
  BUT_ONLY
END

//Noble Scion (d2wke)
ACTION_IF (RESOURCE_CONTAINS ~kit.ids~ ~D2NOBLESCION~) BEGIN
  OUTER_SPRINT kitid ~d2wke~
  OUTER_SPRINT kitname ~NOBLESCION~
  INCLUDE ~%install%/variables2.tph~
  OUTER_SPRINT noblescion  ~%kitid%~
  OUTER_SPRINT bloodbulletsbuff   ~%s1%a~    // spellcapconfig.tph
  OUTER_SPRINT bloodbulletsdamage ~%s9%~
END


//
//thief, monk

//Crow Hunter (d2wka)
ACTION_IF (RESOURCE_CONTAINS ~kit.ids~ ~D2CROWHUNTER~) BEGIN
  OUTER_SPRINT kitid ~d2wka~
  OUTER_SPRINT kitname ~CROWHUNTER~
//  INCLUDE ~%install%/variables2.tph~
  OUTER_SPRINT crowhunter  ~%kitid%~
  LAF d2clab_evasion STR_VAR clab=~%kitid%~ END
END

//Nurse (d2wkg)
ACTION_IF (RESOURCE_CONTAINS ~kit.ids~ ~D2NURSE~) BEGIN
  OUTER_SPRINT kitid ~d2wkg~
  OUTER_SPRINT kitname ~NURSE~
  INCLUDE ~%install%/variables2.tph~
  LAF d2clab_evasion STR_VAR clab=~%kitid%~ END

  OUTER_SPRINT nurse       ~%kitid%~
  OUTER_SPRINT firstaid    ~%s3%~    // supportmode.tph
  OUTER_SPRINT autoimmune  ~%s5%~
  OUTER_SPRINT overdose    ~%s4%~    // spellcapconfig.tph

  //v5.34 updates (nurseconfig)
  OUTER_SPRINT medicaldart  ~%s1%e~
  OUTER_SPRINT allybonus    ~%s1%u~
  OUTER_SPRINT enemybonus   ~%s1%v~
  INCLUDE ~%install%/%kitname%config.tph~

  // set Bubb's Menu level
  ACTION_FOR_EACH spell IN ~%s1%~ ~%s2%~ ~%s3%~ ~%s4%~ ~%s5%~ BEGIN
    COPY_EXISTING ~%spell%.SPL~  ~override~
      WRITE_LONG 0x34 nurse_row    // "level" offset (row for Bubb's Spell Menu)
    IF_EXISTS BUT_ONLY
  END
END

//Medic (d2wkd)
ACTION_IF (RESOURCE_CONTAINS ~kit.ids~ ~D2MEDIC~) BEGIN
  OUTER_SPRINT kitid ~d2wkd~
  OUTER_SPRINT kitname ~MEDIC~
//  INCLUDE ~%install%/variables2.tph~
  OUTER_SPRINT medic  ~%kitid%~
END


//
//bard

//Powder Keg (d2wkb)
ACTION_IF (RESOURCE_CONTAINS ~kit.ids~ ~D2POWDERKEG~) BEGIN
  OUTER_SPRINT kitid ~d2wkb~
  OUTER_SPRINT kitname ~POWDERKEG~
  INCLUDE ~%install%/variables2.tph~
  OUTER_SPRINT powderkeg  ~%kitid%~

  // recheck mods
  OUTER_SPRINT blastingsong      ~%s1%~
  OUTER_SPRINT boomingsong       ~%s2%~
  OUTER_SPRINT dustexplosion     ~%s3%~
  OUTER_SPRINT frenzyingflame    ~%s4%~
  OUTER_SPRINT enhancedbardsong  ~%s5%~
  OUTER_SPRINT pkegstartsong     ~%e2%~
  OUTER_SPRINT pkegdisable       ~%s0%x~
  INCLUDE ~%install%/%kitname%hla2.tph~
  INCLUDE ~%install%/%kitname%var.tph~
  INCLUDE ~%install%/%kitname%icons.tph~

  // subspells
  OUTER_SPRINT blastingsongblast   ~%s1%e~
  OUTER_SPRINT boomingsongblast    ~%s2%e~
  OUTER_SPRINT dustexplosionblast  ~%s3%d~
  OUTER_SPRINT dustblind           ~%s3%a~
  OUTER_SPRINT dustslow            ~%s3%c~
  OUTER_SPRINT dustexplosioncloud  ~%s3%e~
  OUTER_SPRINT frenzyingcloud      ~%s4%e~

  // check clab (effects update)
  ACTION_IF !(RESOURCE_CONTAINS ~%kitid%.2da~  ~d2usb~) BEGIN
    COPY_EXISTING ~%kitid%.2da~  ~override~
      LPF d2_kit_ability_adder INT_VAR passive=1 STR_VAR resource=d2usb END
    BUT_ONLY
  END
END


//
//cleric, druid, shaman

//Blood Minister (d2wk9)
ACTION_IF (RESOURCE_CONTAINS ~kit.ids~ ~D2BLOODMINISTER~) BEGIN
  OUTER_SPRINT kitid ~d2wk9~
  OUTER_SPRINT kitname ~BLOODMINISTER~
  INCLUDE ~%install%/variables2.tph~
  INCLUDE ~%install%/%kitname%profs.tph~

  // variables
  OUTER_SPRINT bloodminister   ~%kitid%~    // holysymbolscheck.tph
  OUTER_SPRINT holysymbolblood ~%m9%~
  OUTER_SPRINT healingblood    ~%s2%~       // supportmode.tph
  OUTER_SPRINT beastblood      ~%s3%~
  OUTER_SPRINT madmanblood     ~%s4%~
  OUTER_SPRINT leadelixir      ~%s5%~
  OUTER_SPRINT ministernodrain ~%e2%~       // iconpatch.tph
END


//
//multiclass

//Spell Fencer (d2wkh)
ACTION_IF (RESOURCE_CONTAINS ~kit.ids~ ~D2SPELLFENCER~) BEGIN
  OUTER_SPRINT kitid ~d2wkh~
  OUTER_SPRINT kitname ~SPELLFENCER~
//  INCLUDE ~%install%/variables2.tph~
END


//
//recheck bleed protection
ACTION_FOR_EACH spell IN
  ~CLERIC_SHIELD_OF_LATHANDER~ ~CLERIC_GREATER_SHIELD_OF_LATHANDER~
  ~MEPR653~
  ~_!SP111~ ~_!SP112~
  ~TG#AEGI~ ~HLA_TG#AEGI~
BEGIN
  ACTION_IF (FILE_EXISTS_IN_GAME ~%spell%.spl~) BEGIN
    LAF d2_bleed_protection STR_VAR resource=~%spell%~ mode=res END
  END ELSE
  ACTION_IF (RESOURCE_CONTAINS ~spell.ids~ ~[^_]%spell%[^_]~) BEGIN
    LAF RES_NUM_OF_SPELL_NAME STR_VAR spell_name=~%spell%~ RET spell_res END
    LAF d2_bleed_protection STR_VAR resource=~%spell_res%~ mode=ids END
  END
END


