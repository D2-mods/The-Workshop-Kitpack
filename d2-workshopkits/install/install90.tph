  OUTER_SPRINT kitid ~d2wk4~
  OUTER_SPRINT kitname ~MOONLIGHTKNIGHT~
  INCLUDE ~%install%/variables2.tph~
  OUTER_SPRINT moonlightknight  ~%kitid%~
  OUTER_SPRINT holysymbolmoon   ~%m9%~
END

//Drifter (d2wkc)
ACTION_IF (RESOURCE_CONTAINS ~kit.ids~ ~D2DRIFTER~) BEGIN
  OUTER_SPRINT kitid ~d2wkc~
  OUTER_SPRINT kitname ~DRIFTER~
  INCLUDE ~%install%/variables2.tph~
  OUTER_SPRINT drifter  ~%kitid%~
