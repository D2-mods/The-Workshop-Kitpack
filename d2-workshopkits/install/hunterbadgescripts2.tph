    REPLACE_TEXTUALLY ~Player2,D2BEAST~ ~Player1,D2BEAST~
  COPY - ~inlined/blocks.baf~  ~inlined/blocks3.baf~
    REPLACE_TEXTUALLY ~Player1~         ~Player3~
    REPLACE_TEXTUALLY ~Player3,D2BEAST~ ~Player1,D2BEAST~
  COPY - ~inlined/blocks.baf~  ~inlined/blocks4.baf~
    REPLACE_TEXTUALLY ~Player1~         ~Player4~
    REPLACE_TEXTUALLY ~Player4,D2BEAST~ ~Player1,D2BEAST~
  COPY - ~inlined/blocks.baf~  ~inlined/blocks5.baf~
    REPLACE_TEXTUALLY ~Player1~         ~Player5~
    REPLACE_TEXTUALLY ~Player5,D2BEAST~ ~Player1,D2BEAST~
  COPY - ~inlined/blocks.baf~  ~inlined/blocks6.baf~
    REPLACE_TEXTUALLY ~Player1~         ~Player6~
    REPLACE_TEXTUALLY ~Player6,D2BEAST~ ~Player1,D2BEAST~

  EXTEND_BOTTOM ~%creres%.bcs~  ~inlined/blocks.baf~
  EXTEND_BOTTOM ~%creres%.bcs~  ~inlined/blocks2.baf~
  EXTEND_BOTTOM ~%creres%.bcs~  ~inlined/blocks3.baf~
  EXTEND_BOTTOM ~%creres%.bcs~  ~inlined/blocks4.baf~
  EXTEND_BOTTOM ~%creres%.bcs~  ~inlined/blocks5.baf~
  EXTEND_BOTTOM ~%creres%.bcs~  ~inlined/blocks6.baf~

