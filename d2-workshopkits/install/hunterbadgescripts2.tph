//set cre timer
<<<<<<<< .../temp/movecre
IF
	!Global("%basevar%move","LOCALS",1)
THEN
	RESPONSE #100
		SetGlobal("%basevar%move","LOCALS",1)
//		JumpToPoint([10.10])
		SetGlobalTimer("%basevar%timer","LOCALS",%duration%)
END
>>>>>>>>
COPY - ~.../temp/movecre~  ~inlined/movecre.baf~
  EVALUATE_BUFFER
EXTEND_BOTTOM ~%creres%.bcs~  ~inlined/movecre.baf~


//cre leaves
<<<<<<<< .../temp/endspell
IF
	Global("%basevar%move","LOCALS",1)
	!GlobalTimerNotExpired("%basevar%timer","LOCALS")
THEN
	RESPONSE #100
		DestroySelf()
END
>>>>>>>>
COPY - ~.../temp/endspell~    ~inlined/endspell.baf~
  EVALUATE_BUFFER
EXTEND_TOP ~%creres%.bcs~  ~inlined/endspell.baf~


END


