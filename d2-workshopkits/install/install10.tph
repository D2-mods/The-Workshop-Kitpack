/*
Misc item pack
*/


OUTER_SET silentmode = 1
OUTER_SET evasionchecks = 2
OUTER_SET buildeffects = 0


//Install
OUTER_TEXT_SPRINT kitid ~d2wkz~
OUTER_TEXT_SPRINT kitname ~MISCITEMS~
INCLUDE ~%install%/inlined.tph~
INCLUDE ~%install%/itemtypes.tph~
INCLUDE ~%install%/spellprep.tph~
INCLUDE ~%install%/spellprep2.tph~
INCLUDE ~%install%/bleedprep.tph~
INCLUDE ~%install%/werewolf.tph~
INCLUDE ~%install%/tempfixes.tph~
INCLUDE ~%install%/moskillscheck.tph~

INCLUDE ~%install%/variables2.tph~
INCLUDE ~%install%/resources.tph~
INCLUDE ~%install%/miscitemsprep.tph~
INCLUDE ~%install%/miscitems2.tph~
INCLUDE ~%install%/miscitemsrunes.tph~
INCLUDE ~%install%/miscitemseffects.tph~
INCLUDE ~%install%/miscitemsscripts.tph~
INCLUDE ~%install%/miscitemsdfiles.tph~
INCLUDE ~%install%/miscitemsstores.tph~

ACTION_IF (silentmode < 3) BEGIN  VERBOSE  END
INCLUDE ~%install%/evasionchecks.tph~
INCLUDE ~%install%/spellprep3.tph~
INCLUDE ~%install%/hbag.tph~
INCLUDE ~%install%/hbagdev.tph~
INCLUDE ~%install%/priceadjust.tph~
INCLUDE ~%install%/castingspeedmod.tph~

OUTER_TEXT_SPRINT mode  ~item~
INCLUDE ~%install%/itemtypepatch.tph~
INCLUDE ~%install%/tobbags.tph~
//INCLUDE ~%install%/aiupscales.tph~
//INCLUDE ~%install%/iwditempatch.tph~
//INCLUDE ~%install%/backupfiles.tph~


